{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/servicios",
      "destination": "/#servicios",
      "permanent": true
    },
    {
      "source": "/proyectos",
      "destination": "/#proyectos",
      "permanent": true
    },
    {
      "source": "/metodo",
      "destination": "/#metodo",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/#contacto",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/Imagenes/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}